#!/bin/bash
# ============================================================
# Script de ejecución de Locust (headless, 2 minutos)
# Generado por Ansible – NO EDITAR MANUALMENTE
# ============================================================
set -euo pipefail

HOST="${LOCUST_HOST:-{{ locust_host }}}"
USERS="${LOCUST_USERS:-20}"
SPAWN_RATE="${LOCUST_SPAWN_RATE:-5}"
RUN_TIME="${LOCUST_RUN_TIME:-2m}"
REPORT_DIR="{{ locust_dir }}/reports"

mkdir -p "$REPORT_DIR"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)

echo "Starting Locust load test against $HOST"
echo "Users: $USERS | Spawn rate: $SPAWN_RATE | Duration: $RUN_TIME"

{{ locust_dir }}/venv/bin/locust \
  --headless \
  --host="$HOST" \
  --users="$USERS" \
  --spawn-rate="$SPAWN_RATE" \
  --run-time="$RUN_TIME" \
  --csv="$REPORT_DIR/locust_${TIMESTAMP}" \
  --html="$REPORT_DIR/locust_report_${TIMESTAMP}.html" \
  -f {{ locust_dir }}/locustfile.py

echo "Report saved at $REPORT_DIR/locust_report_${TIMESTAMP}.html"
