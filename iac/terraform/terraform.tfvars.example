# Production environment values
# Copy to terraform.tfvars and fill secrets — never commit secrets.
project_id = "my-gcp-project-id"
region     = "us-central1"
zone       = "us-central1-a"

# VPC
network_name  = "delivereats-vpc"
subnet_name   = "delivereats-subnet"
subnet_cidr   = "10.0.0.0/24"
pods_cidr     = "10.1.0.0/16"
services_cidr = "10.2.0.0/16"

# GKE
cluster_name = "delivereats-gke"
node_count   = 2
machine_type = "e2-standard-4"
disk_size_gb = 50

# Database (set db_password as env var TF_VAR_db_password)
db_instance_name = "delivereats-sqlserver"

# Cloud Run
frontend_service_name = "delivereats-frontend"
# frontend_image = set to actual image URI, e.g. "gcr.io/PROJECT/delivereats-frontend:latest"
# api_gateway_url = set to your Ingress public IP

# Load-test VM
loadtest_vm_name      = "delivereats-loadtest-vm"
loadtest_machine_type = "e2-medium"
# ssh_pub_key = paste the contents of your public key here
